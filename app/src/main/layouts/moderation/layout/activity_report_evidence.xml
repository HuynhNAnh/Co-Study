<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:src="@drawable/ic_back"
            app:tint="@color/co_study_ink" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="Xem bằng chứng" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">

            <include
                android:id="@+id/admin_request"
                layout="@layout/view_moderation_admin_request" />

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_co_study_card">

                <TextView
                    style="@style/TextAppearance.CoStudy.Title"
                    android:textSize="18sp"
                    android:text="Nội dung hồ sơ được phản ánh" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:id="@+id/report_content" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="BẰNG CHỨNG ĐÃ LƯU" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:id="@+id/report_evidence" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_notice"
                android:id="@+id/evidence_notice">

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:textSize="13sp"
                    android:text="Chưa đủ căn cứ xác định thông tin sai lệch. Bạn có thể yêu cầu bổ sung hoặc đóng báo cáo với lý do rõ ràng." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Actions">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_more_info_button"
            style="@style/Widget.CoStudy.Button.Primary"
            android:text="Yêu cầu bổ sung thông tin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dismiss_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="Bác bỏ báo cáo" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.CoStudy.Button.Outlined"
            android:id="@+id/choose_action_button"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_btn_choose_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/escalate_admin_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_btn_escalate_admin" />
    </LinearLayout>
</LinearLayout>
