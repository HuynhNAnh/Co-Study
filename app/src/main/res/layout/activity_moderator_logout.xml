<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:src="@drawable/ic_back"
            app:tint="@color/co_study_ink" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_logout_title" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4"
            android:text="@string/mod_logout_subtitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">

            <!-- Card 1: Mint Notice -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_notice">

                <TextView
                    style="@style/TextAppearance.CoStudy.Title"
                    android:text="Kết thúc phiên làm việc"
                    android:textColor="@color/co_study_ink"
                    android:textSize="17sp" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:lineSpacingExtra="2dp"
                    android:text="Các quyết định đã xác nhận vẫn được lưu trong lịch sử. Những nội dung chưa xác nhận sẽ chưa được áp dụng."
                    android:textColor="@color/co_study_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Card 2: Current Account -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="TÀI KHOẢN HIỆN TẠI" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="KDV-01 · moderator@costudy.example"
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout style="@style/Widget.CoStudy.Auth.Actions">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_logout_button"
            style="@style/Widget.CoStudy.Button.Primary"
            android:text="@string/mod_btn_confirm_logout" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continue_work_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_btn_continue_work" />
    </LinearLayout>
</LinearLayout>
