<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/co_study_space_12"
                android:paddingEnd="@dimen/co_study_space_24"
                android:paddingTop="@dimen/co_study_space_16"
                android:paddingBottom="@dimen/co_study_space_16">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/back_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_back"
                    app:srcCompat="@drawable/ic_back"
                    app:tint="@color/co_study_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/co_study_space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.CoStudy.Title"
                        android:id="@+id/screen_title"
                        android:text="@string/profile_setup_title" />

                    <TextView
                        style="@style/TextAppearance.CoStudy.Subtitle"
                        android:layout_marginTop="@dimen/co_study_space_8"
                        android:text="@string/profile_setup_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CoStudy.ProfileSetup.Field"
                android:layout_marginTop="@dimen/co_study_space_20">
                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:labelFor="@+id/skills_to_share_input"
                    android:text="@string/profile_setup_skills_to_share"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@id/skills_to_share_input"
                    style="@style/Widget.CoStudy.ProfileSetup.Input"
                    android:hint="@string/profile_setup_skills_to_share_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:nextFocusForward="@id/skills_to_learn_input"
                    android:scrollHorizontally="false" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.CoStudy.ProfileSetup.Field">
                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:labelFor="@+id/skills_to_learn_input"
                    android:text="@string/profile_setup_skills_to_learn"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@id/skills_to_learn_input"
                    style="@style/Widget.CoStudy.ProfileSetup.Input"
                    android:hint="@string/profile_setup_skills_to_learn_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:nextFocusForward="@id/learning_goal_input"
                    android:scrollHorizontally="false" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.CoStudy.ProfileSetup.Field">
                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:labelFor="@+id/learning_goal_input"
                    android:text="@string/profile_setup_learning_goal"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@id/learning_goal_input"
                    style="@style/Widget.CoStudy.ProfileSetup.Input"
                    android:hint="@string/profile_setup_learning_goal_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:nextFocusForward="@id/availability_input"
                    android:scrollHorizontally="false" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CoStudy.ProfileSetup.Field"
                android:minHeight="@dimen/profile_setup_availability_height">
                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:labelFor="@+id/availability_input"
                    android:text="@string/profile_setup_availability"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@id/availability_input"
                    style="@style/Widget.CoStudy.ProfileSetup.Input"
                    android:hint="@string/profile_setup_availability_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:scrollHorizontally="false" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.CoStudy.Subtitle"
                android:layout_marginStart="@dimen/co_study_space_24"
                android:layout_marginEnd="@dimen/co_study_space_24"
                android:layout_marginTop="@dimen/co_study_space_16"
                android:background="@drawable/bg_auth_notice"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:padding="@dimen/co_study_space_16"
                android:text="@string/profile_setup_tip"
                android:textColor="@color/co_study_green" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Actions"
                android:layout_marginTop="@dimen/co_study_space_24">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/complete_button"
                    style="@style/Widget.CoStudy.Button.Primary"
                    android:text="@string/profile_setup_complete" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
