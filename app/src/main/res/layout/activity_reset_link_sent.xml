<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/co_study_space_12"
                android:paddingEnd="@dimen/co_study_space_24"
                android:paddingTop="@dimen/co_study_space_16"
                android:paddingBottom="@dimen/co_study_space_16">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/back_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_back"
                    app:srcCompat="@drawable/ic_back"
                    app:tint="@color/co_study_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/co_study_space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.CoStudy.Title"
                        android:id="@+id/screen_title"
                        android:text="@string/reset_check_email" />

                    <TextView
                        style="@style/TextAppearance.CoStudy.Subtitle"
                        android:layout_marginTop="@dimen/co_study_space_8"
                        android:text="@string/reset_recovery_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/reset_confirmation_icon_size"
                android:layout_height="@dimen/reset_confirmation_icon_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/co_study_space_20"
                android:background="@drawable/bg_reset_confirmation"
                android:importantForAccessibility="no"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_study_check"
                app:tint="@color/co_study_green" />

            <TextView
                android:id="@+id/confirmation_title"
                style="@style/TextAppearance.CoStudy.Title"
                android:layout_marginTop="@dimen/co_study_space_12"
                android:gravity="center"
                android:paddingStart="@dimen/co_study_space_24"
                android:paddingEnd="@dimen/co_study_space_24"
                android:text="@string/reset_confirmation_title"
                android:textSize="18sp" />

            <TextView
                style="@style/TextAppearance.CoStudy.Body"
                android:layout_marginTop="@dimen/co_study_space_12"
                android:gravity="center"
                android:paddingStart="@dimen/co_study_space_24"
                android:paddingEnd="@dimen/co_study_space_24"
                android:text="@string/reset_confirmation_description"
                android:textColor="@color/co_study_muted" />

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Field"
                android:paddingBottom="@dimen/co_study_space_16">

                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:text="@string/reset_receiving_email"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/receiving_email"
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_16"
                    android:textDirection="ltr" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.CoStudy.Subtitle"
                android:layout_marginStart="@dimen/co_study_space_24"
                android:layout_marginEnd="@dimen/co_study_space_24"
                android:layout_marginTop="@dimen/co_study_space_16"
                android:background="@drawable/bg_auth_notice"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:padding="@dimen/co_study_space_16"
                android:text="@string/reset_security_tip"
                android:textColor="@color/co_study_green" />

            <TextView
                style="@style/TextAppearance.CoStudy.Subtitle"
                android:layout_marginStart="@dimen/co_study_space_24"
                android:layout_marginEnd="@dimen/co_study_space_24"
                android:layout_marginTop="@dimen/co_study_space_8"
                android:text="@string/reset_preview_notice" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Actions"
                android:layout_marginTop="@dimen/co_study_space_24">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    style="@style/Widget.CoStudy.Button.Primary"
                    android:text="@string/reset_return_to_login" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/change_email_button"
                    style="@style/Widget.CoStudy.Button.Outlined"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:text="@string/reset_change_email" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
