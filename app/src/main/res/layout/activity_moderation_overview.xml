<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:text="Tổng quan kiểm duyệt" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4"
            android:text="Xin chào, Kiểm duyệt viên" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">

            <!-- Thống kê 3 ô -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/co_study_space_24"
                android:layout_marginEnd="@dimen/co_study_space_24"
                android:layout_marginTop="@dimen/co_study_space_16"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.CoStudy.PartnerProfile.Metric">
                    <TextView
                        style="@style/TextAppearance.CoStudy.Title"
                        android:text="1"
                        android:textColor="@color/co_study_green"
                        android:textSize="22sp" />
                    <TextView
                        style="@style/TextAppearance.CoStudy.Subtitle"
                        android:text="Mới tiếp nhận"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/co_study_space_8"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/Widget.CoStudy.PartnerProfile.Metric">
                    <TextView
                        style="@style/TextAppearance.CoStudy.Title"
                        android:text="1"
                        android:textColor="@color/co_study_green"
                        android:textSize="22sp" />
                    <TextView
                        style="@style/TextAppearance.CoStudy.Subtitle"
                        android:text="Đang xử lý"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/co_study_space_8"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/Widget.CoStudy.PartnerProfile.Metric">
                    <TextView
                        style="@style/TextAppearance.CoStudy.Title"
                        android:text="1"
                        android:textColor="@color/co_study_green"
                        android:textSize="22sp" />
                    <TextView
                        style="@style/TextAppearance.CoStudy.Subtitle"
                        android:text="Chờ Admin"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Banner thông báo căn phải -->
            <TextView
                android:id="@+id/notifications_banner"
                style="@style/TextAppearance.CoStudy.Body"
                android:layout_marginStart="@dimen/co_study_space_24"
                android:layout_marginEnd="@dimen/co_study_space_24"
                android:layout_marginTop="@dimen/co_study_space_16"
                android:gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:text="Thông báo · 2 cập nhật mới"
                android:textColor="@color/co_study_green"
                android:textStyle="bold" />

            <!-- Card Báo cáo 001 -->
            <LinearLayout
                android:id="@+id/report_001_card"
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_co_study_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="CS-202610-001 · Mới"
                    android:textColor="@color/co_study_green"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Title"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:textSize="18sp"
                    android:text="Thông tin hồ sơ" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Nguyên báo cáo hồ sơ Minh Anh.\n06/10/2026 · 09:35" />
            </LinearLayout>

            <!-- Card Báo cáo 002 -->
            <LinearLayout
                android:id="@+id/report_002_card"
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_co_study_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="CS-202610-002 · Đang xử lý"
                    android:textColor="@color/co_study_green"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Title"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:textSize="18sp"
                    android:text="Nội dung quảng cáo lặp lại" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Đã có nội dung đính kèm cần xem xét.\nĐược giao cho bạn" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/see_all_button"
                style="@style/Widget.CoStudy.Button.Primary"
                android:layout_marginStart="@dimen/co_study_space_24"
                android:layout_marginEnd="@dimen/co_study_space_24"
                android:layout_marginTop="@dimen/co_study_space_20"
                android:text="Xem tất cả báo cáo" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/moderation_navigation"
        layout="@layout/view_moderation_navigation" />
</LinearLayout>
