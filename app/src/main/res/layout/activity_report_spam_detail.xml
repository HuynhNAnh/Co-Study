<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:src="@drawable/ic_back"
            app:tint="@color/co_study_ink" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_spam_title" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4"
            android:text="@string/mod_spam_subtitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">

            <!-- Card 1: Reporter target avatar + info -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_co_study_card"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_auth_icon_badge"
                    android:gravity="center"
                    android:text="TĐ"
                    android:textColor="@color/co_mint_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/co_study_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.CoStudy.Title"
                        android:text="Thành Đạt"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/TextAppearance.CoStudy.Subtitle"
                        android:layout_marginTop="2dp"
                        android:text="Hồ sơ bị báo cáo · Phần giới thiệu"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Reporter info -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="NGƯỜI BÁO CÁO" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Thu Hà · 06/10/2026 09:10"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 3: Evidence content -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_co_study_card">

                <TextView
                    style="@style/TextAppearance.CoStudy.Title"
                    android:text="Bằng chứng · Nội dung ND-002"
                    android:textSize="17sp" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:lineSpacingExtra="4dp"
                    android:text="Đăng ký khóa học ngay! Nhắn tin nhận ưu đãi.\nĐăng ký khóa học ngay! Nhắn tin nhận ưu đãi.\nĐăng ký khóa học ngay! Nhắn tin nhận ưu đãi."
                    android:textColor="@color/co_study_ink" />
            </LinearLayout>

            <!-- Card 4: Mint notice -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_notice">

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:text="Nội dung quảng cáo lặp lại trong phần giới thiệu. Đối chiếu quy tắc cộng đồng trước khi xử lý."
                    android:textColor="@color/co_mint_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout style="@style/Widget.CoStudy.Auth.Actions">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/choose_action_button"
            style="@style/Widget.CoStudy.Button.Primary"
            android:text="@string/mod_btn_choose_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/escalate_admin_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_btn_escalate_admin" />
    </LinearLayout>
</LinearLayout>
