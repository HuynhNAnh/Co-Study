<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workflow_root"
    style="@style/Widget.CoStudy.Workflow.Root">

    <LinearLayout style="@style/Widget.CoStudy.Workflow.Header">
        <Space
            android:id="@+id/workflow_status"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/workflow_back"
                style="@style/Widget.CoStudy.Workflow.Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/workflow_title"
                    style="@style/TextAppearance.CoStudy.Title"
                    android:text="@string/screen_dismiss_report_title" />

                <TextView
                    android:id="@+id/workflow_subtitle"
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:text="@string/screen_dismiss_report_subtitle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_workflow_content" />
</LinearLayout>
