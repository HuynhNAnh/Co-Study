<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/co_study_space_24"
    android:layout_marginEnd="@dimen/co_study_space_24"
    android:layout_marginBottom="@dimen/co_study_space_16"
    android:background="@drawable/bg_co_study_card"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/overview_tab"
        style="@style/Widget.CoStudy.Learner.Tab"
        android:text="@string/mod_tab_overview"
        app:drawableTopCompat="@drawable/ic_home" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/reports_tab"
        style="@style/Widget.CoStudy.Learner.Tab"
        android:text="@string/mod_tab_reports"
        app:drawableTopCompat="@drawable/ic_message" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/history_tab"
        style="@style/Widget.CoStudy.Learner.Tab"
        android:text="@string/mod_tab_history"
        app:drawableTopCompat="@drawable/ic_study_calendar" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/account_tab"
        style="@style/Widget.CoStudy.Learner.Tab"
        android:text="@string/mod_tab_account"
        app:drawableTopCompat="@drawable/ic_person" />
</LinearLayout>
