<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    style="@style/Widget.CoStudy.Auth.Card"
    android:background="@drawable/bg_co_study_card"
    android:clickable="true"
    android:focusable="true"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        style="@style/TextAppearance.CoStudy.Label"
        android:textColor="@color/co_study_green"
        android:textStyle="bold"
        android:id="@+id/report_status" />

    <TextView
        style="@style/TextAppearance.CoStudy.Title"
        android:layout_marginTop="@dimen/co_study_space_4"
        android:textSize="18sp"
        android:id="@+id/report_title" />

    <TextView
        style="@style/TextAppearance.CoStudy.Subtitle"
        android:layout_marginTop="@dimen/co_study_space_4"
        android:id="@+id/report_summary" />
</LinearLayout>
