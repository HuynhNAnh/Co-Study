<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:src="@drawable/ic_back"
            app:tint="@color/co_study_ink" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_filter_title" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4"
            android:text="@string/mod_filter_subtitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">

            <!-- Card 1: MÃ BÁO CÁO -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="MÃ BÁO CÁO" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Tất cả mã báo cáo"
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 2: LOẠI NỘI DUNG -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="LOẠI NỘI DUNG" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Tất cả loại nội dung"
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 3: TRẠNG THÁI -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="TRẠNG THÁI" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Mới · Đang xử lý · Chờ Admin"
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 4: NGƯỜI PHỤ TRÁCH -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="NGƯỜI PHỤ TRÁCH" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Tôi và báo cáo chưa được tiếp nhận"
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 5: Mint notice -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_notice">

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:text="Hàng đợi đang hiển thị 3 báo cáo phù hợp với phạm vi này."
                    android:textColor="@color/co_mint_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout style="@style/Widget.CoStudy.Auth.Actions">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply_filter_button"
            style="@style/Widget.CoStudy.Button.Primary"
            android:text="@string/mod_btn_apply_filter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_list_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_btn_back_to_list" />
    </LinearLayout>
</LinearLayout>
