<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:src="@drawable/ic_back"
            app:tint="@color/co_study_ink" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_filter_title" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4"
            android:text="@string/mod_filter_subtitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">
            <!-- Card 1: MÃ BÁO CÁO -->

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="@string/mod_report_query"
                    android:labelFor="@id/query_input" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_marginTop="@dimen/co_study_space_4"
                    style="@style/Widget.CoStudy.Auth.Input"
                    android:id="@+id/query_input"
                    android:hint="@string/mod_report_query_hint"
                    android:maxLength="120"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />
            </LinearLayout>
            <!-- Card 2: LOẠI NỘI DUNG -->

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="@string/mod_filter_evidence"
                    android:labelFor="@id/evidence_input" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/evidence_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/workflow_touch_target"
                    android:spinnerMode="dropdown"
                    android:layout_marginTop="@dimen/co_study_space_4" />
            </LinearLayout>
            <!-- Card 3: TRẠNG THÁI -->

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="TRẠNG THÁI"
                    android:labelFor="@id/status_input" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/status_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/workflow_touch_target"
                    android:spinnerMode="dropdown"
                    android:layout_marginTop="@dimen/co_study_space_4" />
            </LinearLayout>
            <!-- Card 4: NGƯỜI PHỤ TRÁCH -->

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="NGƯỜI PHỤ TRÁCH"
                    android:labelFor="@id/assignee_input" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/assignee_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/workflow_touch_target"
                    android:spinnerMode="dropdown"
                    android:layout_marginTop="@dimen/co_study_space_4" />
            </LinearLayout>
            <!-- Card 5: Mint notice -->

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_notice">

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:text="@string/mod_filter_notice"
                    android:textColor="@color/co_mint_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Actions">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply_filter_button"
            style="@style/Widget.CoStudy.Button.Primary"
            android:text="@string/mod_btn_apply_filter" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.CoStudy.Button.Outlined"
            android:id="@+id/reset_filter_button"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_filter_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_list_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_btn_back_to_list" />
    </LinearLayout>
</LinearLayout>
