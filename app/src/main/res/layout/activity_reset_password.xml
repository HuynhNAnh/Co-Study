<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/co_study_space_12"
                android:paddingEnd="@dimen/co_study_space_24"
                android:paddingTop="@dimen/co_study_space_16"
                android:paddingBottom="@dimen/co_study_space_16">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/back_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_back"
                    app:srcCompat="@drawable/ic_back"
                    app:tint="@color/co_study_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/co_study_space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.CoStudy.Title"
                        android:id="@+id/screen_title"
                        android:text="@string/reset_title" />

                    <TextView
                        style="@style/TextAppearance.CoStudy.Subtitle"
                        android:layout_marginTop="@dimen/co_study_space_8"
                        android:text="@string/reset_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:layout_marginTop="@dimen/co_study_space_20"
                android:background="@drawable/bg_auth_notice">

                <TextView
                    android:id="@+id/reset_intro_title"
                    style="@style/TextAppearance.CoStudy.Title"
                    android:text="@string/reset_intro_title"
                    android:textSize="18sp" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:text="@string/reset_intro_description"
                    android:textColor="@color/co_study_muted" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.CoStudy.Auth.Field">
                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:labelFor="@+id/email_input"
                    android:text="@string/reset_registered_email"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@id/email_input"
                    style="@style/Widget.CoStudy.Auth.Input"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Actions"
                android:layout_marginTop="@dimen/co_study_space_24">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send_link_button"
                    style="@style/Widget.CoStudy.Button.Primary"
                    android:text="@string/reset_send_link" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    style="@style/Widget.CoStudy.Button.Outlined"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:text="@string/reset_back_to_login" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
