<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CoStudy.SkillCombo"
        android:hint="@string/profile_skills_to_share">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/skills_to_share_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:textColor="@color/co_study_ink" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout style="@style/Widget.CoStudy.ProfileSetup.Field">
        <TextView
            style="@style/TextAppearance.CoStudy.Label"
            android:labelFor="@id/evidence_input"
            android:text="@string/skill_evidence_title" />

        <TextView
            android:id="@+id/evidence_status"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/evidence_input"
            style="@style/Widget.CoStudy.ProfileSetup.Input"
            android:hint="@string/skill_evidence_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:maxLines="6" />

        <TextView
            android:id="@+id/attachment_name"
            style="@style/TextAppearance.CoStudy.Body"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/choose_attachment_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/skill_evidence_choose_attachment" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remove_attachment_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/skill_evidence_remove_attachment"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/skill_evidence_submit_note" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CoStudy.SkillCombo"
        android:hint="@string/profile_skills_to_learn">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/skills_to_learn_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:textColor="@color/co_study_ink" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout style="@style/Widget.CoStudy.ProfileSetup.Field">
        <TextView
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:labelFor="@id/learning_goal_input"
            android:text="@string/profile_setup_learning_goal"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/learning_goal_input"
            style="@style/Widget.CoStudy.ProfileSetup.Input"
            android:hint="@string/profile_setup_learning_goal_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:scrollHorizontally="false" />
    </LinearLayout>

    <LinearLayout
        style="@style/Widget.CoStudy.ProfileSetup.Field"
        android:minHeight="@dimen/profile_setup_availability_height">

        <TextView
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:labelFor="@id/availability_input"
            android:text="@string/profile_setup_availability"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/availability_input"
            style="@style/Widget.CoStudy.ProfileSetup.Input"
            android:hint="@string/profile_setup_availability_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:scrollHorizontally="false" />
    </LinearLayout>
</LinearLayout>
