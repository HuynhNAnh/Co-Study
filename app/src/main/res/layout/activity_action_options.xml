<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:src="@drawable/ic_back"
            app:tint="@color/co_study_ink" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_action_options_title" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4"
            android:text="@string/mod_action_options_subtitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">

            <!-- Card 1: BIỆN PHÁP ĐỀ XUẤT -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="BIỆN PHÁP ĐỀ XUẤT" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Cảnh báo người đăng và ẩn phần giới thiệu vi phạm"
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 2: LÝ DO · BẮT BUỘC -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="LÝ DO · BẮT BUỘC" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Phần giới thiệu chứa nội dung quảng cáo lặp lại, không phù hợp mục đích trao đổi kỹ năng và ghép cặp học tập."
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 3: THÔNG BÁO CHO NGƯỜI ĐĂNG -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="THÔNG BÁO CHO NGƯỜI ĐĂNG" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Vui lòng xóa nội dung quảng cáo lặp lại và cập nhật giới thiệu phù hợp với hoạt động học tập."
                    android:textColor="@color/co_study_ink"
                    android:textSize="15sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Card 4: Mint notice -->
            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_notice">

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:text="Biện pháp chỉ áp dụng cho nội dung ND-002. Việc khóa tài khoản cần chuyển Admin xem xét."
                    android:textColor="@color/co_mint_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout style="@style/Widget.CoStudy.Auth.Actions">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_action_button"
            style="@style/Widget.CoStudy.Button.Primary"
            android:text="@string/mod_btn_review_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/escalate_admin_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="@string/mod_btn_escalate_admin" />
    </LinearLayout>
</LinearLayout>
