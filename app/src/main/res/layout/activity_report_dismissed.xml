<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        style="@style/Widget.CoStudy.Auth.Header"
        android:background="@color/white">

        <TextView
            android:id="@+id/screen_title"
            style="@style/TextAppearance.CoStudy.Title"
            android:text="Đã đóng báo cáo" />

        <TextView
            android:id="@+id/screen_subtitle"
            style="@style/TextAppearance.CoStudy.Subtitle"
            android:layout_marginTop="@dimen/co_study_space_4"
            android:text="CS-202610-001 · Thiếu căn cứ" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/co_study_space_16">

            <!-- Check circle -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/co_study_space_24"
                android:background="@drawable/bg_co_study_mint_circle"
                android:padding="16dp"
                android:src="@drawable/ic_study_check"
                app:tint="@color/co_study_green" />

            <TextView
                style="@style/TextAppearance.CoStudy.Title"
                android:layout_marginTop="@dimen/co_study_space_16"
                android:gravity="center"
                android:textSize="20sp"
                android:text="Đã ghi nhận kết luận" />

            <TextView
                style="@style/TextAppearance.CoStudy.Body"
                android:layout_marginStart="@dimen/co_study_space_24"
                android:layout_marginEnd="@dimen/co_study_space_24"
                android:layout_marginTop="@dimen/co_study_space_8"
                android:gravity="center"
                android:textColor="@color/co_study_muted"
                android:text="Người gửi được thông báo lý do đóng báo cáo.\nKhông áp dụng xử lý đối với hồ sơ Minh Anh." />

            <LinearLayout style="@style/Widget.CoStudy.Auth.Field">

                <TextView
                    style="@style/TextAppearance.CoStudy.Label"
                    android:text="KẾT LUẬN ĐÃ LƯU" />

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:layout_marginTop="@dimen/co_study_space_4"
                    android:text="Chưa đủ căn cứ xác định vi phạm"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Card"
                android:background="@drawable/bg_auth_notice">

                <TextView
                    style="@style/TextAppearance.CoStudy.Body"
                    android:textSize="13sp"
                    android:text="Khi có bằng chứng mới, người dùng có thể gửi báo cáo mới kèm thông tin bổ sung." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout style="@style/Widget.CoStudy.Auth.Actions">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_to_list_button"
            style="@style/Widget.CoStudy.Button.Primary"
            android:text="Về danh sách báo cáo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_to_overview_button"
            style="@style/Widget.CoStudy.Button.Outlined"
            android:layout_marginTop="@dimen/co_study_space_8"
            android:text="Về tổng quan" />
    </LinearLayout>
</LinearLayout>
