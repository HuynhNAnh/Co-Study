<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/role_selection_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/co_study_surface"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/co_study_space_24"
            android:paddingTop="@dimen/co_study_space_28"
            android:paddingEnd="@dimen/co_study_space_24"
            android:paddingBottom="@dimen/co_study_space_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Co-Study"
                android:textColor="@color/co_study_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/screen_title"
                style="@style/TextAppearance.CoStudy.Title"
                android:layout_marginTop="@dimen/co_study_space_12"
                android:text="Chọn vai trò demo" />

            <TextView
                style="@style/TextAppearance.CoStudy.Body"
                android:layout_marginTop="@dimen/co_study_space_8"
                android:text="Chọn khu vực bạn muốn trải nghiệm. Bản demo không cần tài khoản hay cơ sở dữ liệu."
                android:textColor="@color/co_study_muted" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/learner_role_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/co_study_space_28"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/co_study_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/co_study_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/co_study_space_20">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Học viên"
                        android:textColor="@color/co_study_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/co_study_space_8"
                        android:text="Xem trang chủ, khám phá bạn học và các kỹ năng trao đổi."
                        android:textColor="@color/co_study_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/moderator_role_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/co_study_space_16"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/co_study_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/co_study_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/co_study_space_20">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kiểm duyệt viên"
                        android:textColor="@color/co_study_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/co_study_space_8"
                        android:text="Vào luồng đăng nhập và xử lý báo cáo cộng đồng."
                        android:textColor="@color/co_study_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/admin_role_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/co_study_space_16"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/co_study_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/co_study_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/co_study_space_20">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Admin"
                        android:textColor="@color/co_study_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/co_study_space_8"
                        android:text="Mở bảng điều khiển và các luồng quản trị hệ thống."
                        android:textColor="@color/co_study_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/co_study_space_20"
                android:background="@drawable/bg_auth_notice"
                android:padding="@dimen/co_study_space_16"
                android:text="Chế độ trình diễn · Các thao tác dùng dữ liệu minh họa, chưa lưu lên máy chủ."
                android:textColor="@color/co_study_ink"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
