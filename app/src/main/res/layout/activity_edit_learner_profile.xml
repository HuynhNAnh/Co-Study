<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workflow_root"
    style="@style/Widget.CoStudy.Workflow.Root">

    <LinearLayout style="@style/Widget.CoStudy.Workflow.Header">
        <Space
            android:id="@+id/workflow_status"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/workflow_back"
                style="@style/Widget.CoStudy.Workflow.Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/workflow_title"
                    style="@style/TextAppearance.CoStudy.Title"
                    android:text="@string/screen_edit_learner_profile_title" />

                <TextView
                    android:id="@+id/workflow_subtitle"
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:text="@string/screen_edit_learner_profile_subtitle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <LinearLayout style="@style/Widget.CoStudy.ProfileSetup.Field">
                <TextView
                    style="@style/TextAppearance.CoStudy.Subtitle"
                    android:labelFor="@id/learner_name_input"
                    android:text="@string/profile_edit_name" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/learner_name_input"
                    style="@style/Widget.CoStudy.Auth.Input"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLength="100"
                    android:singleLine="true" />
            </LinearLayout>

            <include
                android:id="@+id/profile_fields"
                layout="@layout/view_learner_profile_fields" />

            <LinearLayout
                style="@style/Widget.CoStudy.Auth.Actions"
                android:layout_marginTop="@dimen/co_study_space_24">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_button"
                    style="@style/Widget.CoStudy.Button.Primary"
                    android:text="@string/profile_edit_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_button"
                    style="@style/Widget.CoStudy.Button.Outlined"
                    android:layout_marginTop="@dimen/co_study_space_8"
                    android:text="@string/profile_edit_cancel" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
