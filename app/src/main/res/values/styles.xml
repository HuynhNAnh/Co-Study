<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.CoStudy.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/co_study_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.CoStudy.Title" parent="TextAppearance.CoStudy.Body">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CoStudy.Label" parent="TextAppearance.CoStudy.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.CoStudy.Subtitle" parent="TextAppearance.CoStudy.Body">
        <item name="android:textColor">@color/co_study_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.CoStudy.Auth.Header" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/white</item>
        <item name="android:minHeight">100dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/co_study_space_24</item>
        <item name="android:paddingEnd">@dimen/co_study_space_24</item>
        <item name="android:paddingTop">@dimen/co_study_space_28</item>
        <item name="android:paddingBottom">@dimen/co_study_space_20</item>
    </style>

    <style name="Widget.CoStudy.Auth.Actions" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/co_study_space_24</item>
        <item name="android:paddingEnd">@dimen/co_study_space_24</item>
        <item name="android:paddingBottom">@dimen/co_study_space_16</item>
    </style>

    <style name="Widget.CoStudy.Welcome.Feature" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/co_study_space_24</item>
        <item name="android:layout_marginEnd">@dimen/co_study_space_24</item>
        <item name="android:layout_marginTop">@dimen/co_study_space_16</item>
        <item name="android:background">@drawable/bg_co_study_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">74dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">@dimen/co_study_space_16</item>
    </style>

    <style name="Widget.CoStudy.Welcome.FeatureIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.CoStudy.Welcome.FeatureText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/co_study_space_12</item>
        <item name="android:layout_marginEnd">@dimen/co_study_space_12</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.CoStudy.Welcome.FeatureArrow" parent="Widget.CoStudy.Welcome.FeatureIcon">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
    </style>

    <style name="Widget.CoStudy.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">@dimen/co_study_space_12</item>
        <item name="android:paddingBottom">@dimen/co_study_space_12</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/co_study_ink</item>
        <item name="cornerRadius">@dimen/co_study_radius_card</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.CoStudy.Button.Outlined" parent="Widget.CoStudy.Button.Primary">
        <item name="android:textColor">@color/co_study_ink</item>
        <item name="backgroundTint">@color/white</item>
        <item name="rippleColor">#19142D40</item>
        <item name="strokeColor">@color/co_study_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
